# Upwork Bidder - Environment Variables
# Copy this to .env and fill in values as needed

# Dashboard
DASHBOARD_PORT=3000

# Optional: LLM-enhanced proposal generation
# Uncomment and set ONE provider to enable AI-enhanced proposals
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# LLM provider: "openai" | "anthropic" | "none"
LLM_PROVIDER=none
